# Copy to agent/fraudlens_agent/.env (adk web / adk run load it automatically)
GOOGLE_GENAI_USE_VERTEXAI=TRUE
GOOGLE_CLOUD_PROJECT=your-project-id
# Gemini endpoint location; "global" has the widest model availability
GOOGLE_CLOUD_LOCATION=global
FRAUDLENS_AGENT_MODEL=gemini-2.5-flash
# BigQuery
FRAUDLENS_BQ_DATASET=fraudlens
FRAUDLENS_BQ_LOCATION=us-central1
FRAUDLENS_HIGH_RISK_SCORE=0.20
# Pin "today" (YYYY-MM-DD) for reproducible relative dates; evals set this themselves
# FRAUDLENS_TODAY=2026-10-14
